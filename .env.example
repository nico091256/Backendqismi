PORT=5000
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
NODE_ENV=production
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174,https://your-frontend.vercel.app"
# Manager ro'yxatdan o'tishi uchun maxsus yashirin kod
MANAGER_SECRET="your_strong_manager_secret_here"
# JWT imzolash uchun maxfiy kalit (kamida 32 ta tasodifiy belgi)
JWT_SECRET="your_very_strong_jwt_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"
# Telegram Bot Token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

